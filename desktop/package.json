{
  "name": "quillancode-desktop",
  "version": "1.0.0",
  "description": "Electron shell for the quillancode agentic IDE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir --publish never"
  },
  "build": {
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": "dir"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8"
  }
}
